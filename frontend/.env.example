# =====================================================================
# Great Energy Field — FRONTEND (Next.js) environment
# Copy to `frontend/.env.local` and fill in.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets here.
# =====================================================================

# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# WalletConnect project id (added in Week 3 for wallet login).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

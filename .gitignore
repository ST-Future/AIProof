# =====================================================================
# Single root .gitignore for the whole repo (backend + frontend).
# Patterns without a leading slash apply in every subdirectory.
# =====================================================================

# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Python / FastAPI backend ---
backend/.venv/
**/__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# --- Node / Next.js frontend ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
frontend/.next/
frontend/out/
frontend/build/
frontend/next-env.d.ts
*.tsbuildinfo
coverage/
.vercel

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- OS / editor / misc ---
.DS_Store
*.pem
.idea/
.vscode/

# --- Source working doc (large binary; not part of the app) ---
Great_Energy_Field_Phase_1_MVP_Agent_Training_System_Updated.docx

# --- Internal planning doc (kept local, not published to the repo) ---
development_plan.md
